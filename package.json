{
  "name": "lidar-slam-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Browser sandbox for 2D LiDAR simulation, log-odds occupancy mapping and scan-matching odometry correction.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./geometry": "./src/geometry.js",
    "./rng": "./src/rng.js",
    "./world": "./src/world.js",
    "./maps": "./src/maps.js",
    "./lidar": "./src/lidar.js",
    "./motion": "./src/motion.js",
    "./grid": "./src/grid.js",
    "./distance": "./src/distance.js",
    "./scanmatch": "./src/scanmatch.js",
    "./mcl": "./src/mcl.js",
    "./metrics": "./src/metrics.js",
    "./autopilot": "./src/autopilot.js",
    "./export": "./src/export.js",
    "./sim": "./src/sim.js",
    "./scanlog": "./src/scanlog.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 \"tests/*.test.js\"",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node bin/lidar-slam-lab.js benchmark",
    "serve": "node scripts/serve.js",
    "check": "npm run format:check && npm run typecheck && npm run coverage"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "bin": {
    "lidar-slam-lab": "bin/lidar-slam-lab.js"
  }
}
